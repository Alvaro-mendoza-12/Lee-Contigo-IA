# Opcional en local. En Vercel puede autenticarse con OIDC y créditos de AI Gateway.
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-3.8-flash
AI_FALLBACK_MODEL=openai/gpt-5.4-nano
AI_IMAGE_MODEL=bfl/flux-3-image
# Sin solicitudes a modelos de imágenes; usa arte original incluido.
AI_IMAGE_MODE=collection
# Voz opcional: solo servidor. Si falta o falla, se usa la voz del navegador.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Ilustraciones de seis escenas con Workers AI. Solo servidor; sin compra de créditos.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Respaldo opcional de texto; solo variables del servidor. Nunca NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=
OPENROUTER_API_KEY_6=
OPENROUTER_API_KEY_7=
OPENROUTER_API_KEY_8=
